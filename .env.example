# AlwaysCited environment variables
# Copy to .env.local and fill in real values before deploying

# Email destination for contact form submissions
CONTACT_EMAIL_DESTINATION=hello@alwayscited.com

# Resend API key. REQUIRED - without it the contact form and the scan request
# form both return an error instead of sending. Get your key at resend.com,
# then set it in the Vercel project environment variables.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend. The default
# onboarding@resend.dev only delivers to your own Resend account address, so
# set this to something on alwayscited.com once the domain is verified.
SCAN_FROM_EMAIL="alwayscited <hello@alwayscited.com>"

# Production URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://alwayscited.com

# DataForSEO API credentials. Used by the scan to run one Google AI Overview
# check per submission (src/lib/dataforseo.ts).
#
# Get them from https://app.dataforseo.com/api-access - the login is the
# account email, the password is the API password, NOT the dashboard password.
#
# Set these in the Vercel project environment variables. Never commit real
# values: this repository is public.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=


# Protects /api/example/refresh. Vercel Cron sends it as a Bearer token.
# Generate any long random string.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Free scan, phase 1. Set all of these in the Vercel project environment.
# This repository is public: never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase, the `alwayscited` project (NOT nomada-dashboards). The service role
# key bypasses RLS, so it is server-only and must never be prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Reads the site, writes the questions, extracts the brand list.
ANTHROPIC_API_KEY=

# Salt for hashing visitor IP addresses. Any long random string. Raw IPs are
# never stored, and without this the per-IP limit refuses to run.
IP_HASH_SALT=

# Cloudflare Turnstile. The site key is public by design; the secret is not.
# Without the secret, production refuses every scan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HTTP Basic credentials for /admin/scans. Without them the page returns 503
# rather than opening up.
ADMIN_USER=
ADMIN_PASSWORD=

# GA4 Measurement Protocol API secret (GA4 > Admin > Data streams > the web
# stream > Measurement Protocol API secrets). Server only - never prefix it
# NEXT_PUBLIC_. The Stripe webhook sends purchases to GA4 with it; unset, they
# are not sent. The measurement id itself is public and lives in
# src/config/analytics.ts.
GA4_API_SECRET=
